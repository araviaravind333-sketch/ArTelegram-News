# Copy to .env for local runs. NEVER commit the real .env.
# In CI these are supplied as GitHub Secrets, not as a file.

TELEGRAM_BOT_TOKEN=123456789:AA-replace-me
TELEGRAM_CHAT_ID=-1001234567890

# Optional: enables Claude-powered hook / CTA / roadmap refinement.
# Without it the pipeline falls back to the deterministic engine.
ANTHROPIC_API_KEY=

# Instagram Graph API (Business/Creator account linked to a Facebook Page)
INSTA_ACCESS_TOKEN=
INSTA_USER_ID=

# Optional: free YouTube Data API v3 key (console.cloud.google.com -> APIs &
# Services -> Credentials -> API key; enable "YouTube Data API v3"). Adds a
# "trending on YouTube right now" signal to Top Picks ranking. No equivalent
# exists for Twitter/X - its free API tier cannot read trends or search.
YOUTUBE_API_KEY=

# --- Optional tuning -------------------------------------------------------
# GRAPH_API_VERSION=v21.0
# MIN_ITEMS_PER_CATEGORY=7
# MAX_ITEMS_PER_CATEGORY=10
# AUDIT_POST_COUNT=50          # latest posts (all formats) the daily report reads
# FEED_TIMEOUT_SECONDS=20
# OUTPUT_DIR=output

# --- 20-minute news pulse --------------------------------------------------
# PULSE_MINUTES=60              # must match the cron in news_pulse.yml
# PULSE_LOOKBACK_MINUTES=90     # absorbs RSS + scheduler lag
# PULSE_MAX_ITEMS=10            # stories per post
# PULSE_MIN_SCORE=45            # below this, hold rather than post filler
# SEEN_TTL_HOURS=48             # how long a story stays suppressed
